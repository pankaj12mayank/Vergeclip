# ═══════════════════════════════════════════════════════════
#  Vergeclip AI — Environment Configuration (Example)
#  Copy to .env and fill your keys. Never commit .env.
#  All keys can also be set live from Admin Portal → Settings.
# ═══════════════════════════════════════════════════════════

# ── Video Downloader (YouTube high-speed API) ──────────────
# Get a key at: https://videosailor.com/
VIDEOSAILOR_API_KEY=your_videosailor_key_here

# ── Transcription Provider & Keys ──────────────────────────
# Options: groq (FREE whisper) | assemblyai (paid) | faster_whisper (local)
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here          # https://console.groq.com/keys
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# ── AI Ranking Provider & Keys (LLM for hooks/scores) ─────
# Options: gemini (recommended) | openai | groq | ollama | deepseek | openrouter
RANKING_PROVIDER=gemini
GOOGLE_API_KEY=your_google_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
# GEMINI_MODEL=gemini-3.6-flash

# ── Optional: AI Scene Generation (Script-to-Video) ───────
# Cloud: Agnes AI (free) / Pollinations (paid). Local: CogVideoX via ComfyUI.
# AGNES_API_KEY=your_agnes_key_here
# POLLINATIONS_API_KEY=your_pollinations_key_here

# ── Auth (JWT) ─────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MIN=10080
# Set true to require login for pipeline/config/delete. False allows guests.
AUTH_REQUIRED=false
CORS_ORIGINS=*

# ── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
# Set RELOAD=true for dev hot-reload
RELOAD=false
# ENV=development   # set "production" to enforce required keys at startup

# ── Database (optional; SQLite default) ────────────────────
# DATABASE_URL=sqlite:///./data/users.db
