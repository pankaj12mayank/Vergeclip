# ==============================================================================
# Vergeclip AI — Environment Configuration (Example)
# Copy to .env and fill your keys. Never commit .env.
# All keys can also be set live from Admin Portal → Settings.
# ==============================================================================

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MIN=10080
# Set true to require login for pipeline/config/delete. False allows guests.
AUTH_REQUIRED=false
CORS_ORIGINS=*

# ── Transcription ───────────────────────────────────────────────────────────────
# Options: groq (FREE whisper-large-v3) | assemblyai (paid) | faster_whisper (local, no key)
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here                  # https://console.groq.com/keys
ASSEMBLYAI_API_KEY=

# ── AI Ranking / LLM (Script Generation + Clip Scoring) ────────────────────────
# Options: gemini | openai | groq | ollama | deepseek | openrouter | custom (OpenAI-compatible)
RANKING_PROVIDER=groq
# Gemini (Google) — free tier available at https://aistudio.google.com/
GOOGLE_API_KEY=
# OpenAI / Groq / OpenRouter / DeepSeek
OPENAI_API_KEY=your_openai_or_groq_key_here
# Custom OpenAI-compatible endpoint (Groq, DeepSeek, vLLM, LM Studio, etc.)
CUSTOM_AI_BASE_URL=https://api.groq.com/openai/v1
CUSTOM_AI_API_KEY=your_groq_key_here
CUSTOM_AI_MODEL=llama-3.1-8b-instant
# Ollama (local LLM — must run: ollama serve)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── AI Scene Generation (Script-to-Video) ──────────────────────────────────────
# Providers are configured live in Admin → Pipeline Config → Scene Generation and
# stored in the database. No .env keys are required. Choose one active provider:
#   Local — Wan2.1 / LTX-Video (your GPU via ComfyUI, offline)
#   fal.ai (cloud)  |  Replicate (cloud)

# ── Video Downloader (YouTube) ──────────────────────────────────────────────────
# Get a key at: https://videosailor.com/
VIDEOSAILOR_API_KEY=

# ── Local ComfyUI (optional, GPU required) ─────────────────────────────────────
# Only used if Scene Generation provider is "local"
COMFYUI_URL=http://127.0.0.1:8188

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
RELOAD=false

# ── Database (optional; SQLite default) ────────────────────────────────────────
# DATABASE_URL=sqlite:///./data/users.db
